{
  "format": "LCANVAS",
  "version": 2,
  "name": "Canvas Live architecture",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "layers": [
    {
      "id": "layer-background",
      "name": "Workspace",
      "visible": true,
      "locked": false
    },
    {
      "id": "layer-links",
      "name": "Connections",
      "visible": true,
      "locked": false
    },
    {
      "id": "layer-main",
      "name": "Components",
      "visible": true,
      "locked": false
    }
  ],
  "elements": [
    {
      "id": "workspace-area",
      "color": "#38586b",
      "layerId": "layer-background",
      "areaId": null,
      "x": 60,
      "y": 185,
      "width": 1030,
      "height": 490,
      "type": "area",
      "name": "Local-first workspace",
      "fill": "#101d29"
    },
    {
      "id": "title",
      "color": "#edf5fc",
      "layerId": "layer-background",
      "areaId": null,
      "x": 100,
      "y": 35,
      "width": 950,
      "height": 60,
      "type": "text",
      "text": "Canvas Live",
      "fontSize": 42,
      "textAlign": "left",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "fontWeight": "bold"
    },
    {
      "id": "subtitle",
      "color": "#9cb3c6",
      "layerId": "layer-background",
      "areaId": null,
      "x": 100,
      "y": 105,
      "width": 950,
      "height": 48,
      "type": "text",
      "text": "A shared visual workspace for people and connected AI.",
      "fontSize": 21,
      "textAlign": "left",
      "verticalAlign": "middle",
      "fontFamily": "sans"
    },
    {
      "id": "footer",
      "color": "#9cb3c6",
      "layerId": "layer-background",
      "areaId": null,
      "x": 100,
      "y": 705,
      "width": 950,
      "height": 48,
      "type": "text",
      "text": "Local files · explicit sharing · one history for UI and AI.",
      "fontSize": 18,
      "textAlign": "left",
      "verticalAlign": "middle",
      "fontFamily": "sans"
    },
    {
      "id": "editor",
      "color": "#37d6c6",
      "layerId": "layer-main",
      "areaId": null,
      "x": 100,
      "y": 245,
      "width": 250,
      "height": 130,
      "type": "rectangle",
      "fill": "#15383e",
      "text": "Canvas editor\nShapes · text · embeds",
      "fontSize": 21,
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "textColor": "#edf5fc"
    },
    {
      "id": "operations",
      "color": "#37d6c6",
      "layerId": "layer-main",
      "areaId": null,
      "x": 440,
      "y": 245,
      "width": 250,
      "height": 130,
      "type": "hexagon",
      "fill": "#15383e",
      "text": "Validated operations\nOne model for UI + AI",
      "fontSize": 21,
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "textColor": "#edf5fc"
    },
    {
      "id": "library",
      "color": "#88aaff",
      "layerId": "layer-main",
      "areaId": null,
      "x": 780,
      "y": 245,
      "width": 250,
      "height": 130,
      "type": "cylinder",
      "fill": "#23324d",
      "text": "Local library\nProjects · files",
      "fontSize": 21,
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "textColor": "#edf5fc"
    },
    {
      "id": "ai-client",
      "color": "#e5b267",
      "layerId": "layer-main",
      "areaId": null,
      "x": 100,
      "y": 500,
      "width": 250,
      "height": 130,
      "type": "rectangle",
      "fill": "#3c3020",
      "text": "External AI client\nYour chosen assistant",
      "fontSize": 21,
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "textColor": "#edf5fc"
    },
    {
      "id": "companion",
      "color": "#e5b267",
      "layerId": "layer-main",
      "areaId": null,
      "x": 440,
      "y": 500,
      "width": 250,
      "height": 130,
      "type": "rectangle",
      "fill": "#3c3020",
      "text": "MCP companion\nPair · share · edit",
      "fontSize": 21,
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "textColor": "#edf5fc"
    },
    {
      "id": "portable",
      "color": "#a1d98c",
      "layerId": "layer-main",
      "areaId": null,
      "x": 780,
      "y": 500,
      "width": 250,
      "height": 130,
      "type": "rectangle",
      "fill": "#293d2b",
      "text": "Portable folder\nApp · runtime · data",
      "fontSize": 21,
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontFamily": "sans",
      "textColor": "#edf5fc"
    },
    {
      "id": "edit-operation",
      "color": "#37d6c6",
      "layerId": "layer-links",
      "areaId": null,
      "type": "connection",
      "fromId": "editor",
      "toId": "operations",
      "style": "straight",
      "startArrow": false,
      "endArrow": true,
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "operation-save",
      "color": "#37d6c6",
      "layerId": "layer-links",
      "areaId": null,
      "type": "connection",
      "fromId": "operations",
      "toId": "library",
      "style": "straight",
      "startArrow": false,
      "endArrow": true,
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "client-companion",
      "color": "#e5b267",
      "layerId": "layer-links",
      "areaId": null,
      "type": "connection",
      "fromId": "ai-client",
      "toId": "companion",
      "style": "straight",
      "startArrow": false,
      "endArrow": true,
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "companion-operation",
      "color": "#e5b267",
      "layerId": "layer-links",
      "areaId": null,
      "type": "connection",
      "fromId": "companion",
      "toId": "operations",
      "style": "straight",
      "startArrow": false,
      "endArrow": true,
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "library-portable",
      "color": "#88aaff",
      "layerId": "layer-links",
      "areaId": null,
      "type": "connection",
      "fromId": "library",
      "toId": "portable",
      "style": "straight",
      "startArrow": false,
      "endArrow": true,
      "fromSide": "bottom",
      "toSide": "top",
      "linePattern": "dashed",
      "endPointer": "diamond"
    }
  ]
}
